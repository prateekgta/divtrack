# Required env vars:
JWT_PRIVATE_KEY=<your-rsa-private-key>
JWT_PUBLIC_KEY=<your-rsa-public-key>

# Defaults for local dev (docker-compose):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/divtrack?currentSchema=public
SPRING_DATASOURCE_USERNAME=divtrack
SPRING_DATASOURCE_PASSWORD=localdev123

# Generate keys with: bash generate-keys.sh
